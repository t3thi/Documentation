{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T3THI Knowledge Object front matter",
  "description": "Structured front matter for one canonical, independently referenceable Knowledge Object. Properties prefixed with x- are reserved for documented repository extensions.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9-]*$": true
  },
  "required": [
    "id",
    "kind",
    "state",
    "maturity",
    "title",
    "topic",
    "responsibilities",
    "summary",
    "created",
    "updated",
    "evidence",
    "review"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/knowledgeId"
    },
    "kind": {
      "enum": [
        "behavior",
        "finding",
        "assumption",
        "requirement",
        "vision",
        "recommendation",
        "approach",
        "question",
        "work"
      ]
    },
    "state": {
      "enum": [
        "active",
        "resolved",
        "implemented",
        "superseded",
        "rejected"
      ]
    },
    "maturity": {
      "enum": [
        "tentative",
        "supported",
        "established",
        "verified"
      ]
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "topic": {
      "$ref": "#/$defs/slug"
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "summary": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "created": {
      "$ref": "#/$defs/date"
    },
    "updated": {
      "$ref": "#/$defs/date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "relations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "external_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/externalArtifact"
      }
    },
    "decision_required": {
      "type": "boolean",
      "description": "Whether this proposition exposes a decision that still requires explicit authorization."
    },
    "review": {
      "$ref": "#/$defs/review"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision_required": {
            "const": true
          }
        },
        "required": [
          "decision_required"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "question"
          },
          "state": {
            "const": "active"
          }
        }
      }
    }
  ],
  "$defs": {
    "knowledgeId": {
      "type": "string",
      "pattern": "^K-[0-9]{6}$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^D-[0-9]{6}$"
    },
    "internalId": {
      "anyOf": [
        {
          "$ref": "#/$defs/knowledgeId"
        },
        {
          "$ref": "#/$defs/decisionId"
        }
      ]
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[^\\s#]+$"
    },
    "sourceReference": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[^\\s#]+(?:#[^\\s]+)?$"
    },
    "evidenceRelation": {
      "enum": [
        "establishes",
        "supports",
        "reinforces",
        "refines",
        "confirms",
        "implements",
        "supersedes",
        "rejects"
      ]
    },
    "semanticRelation": {
      "enum": [
        "supports",
        "refines",
        "contradicts",
        "depends_on",
        "supersedes",
        "implements",
        "answers",
        "motivates",
        "related_to"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9-]*$": true
      },
      "required": [
        "source",
        "relation"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/sourceId"
        },
        "location": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "relation": {
          "$ref": "#/$defs/evidenceRelation"
        },
        "summarized_in": {
          "$ref": "#/$defs/sourceReference"
        },
        "note": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9-]*$": true
      },
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/semanticRelation"
        },
        "target": {
          "$ref": "#/$defs/internalId"
        },
        "note": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "supersedes"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/knowledgeId"
              }
            }
          }
        }
      ]
    },
    "externalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9-]*$": true
      },
      "required": [
        "id",
        "relation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sourceId"
        },
        "relation": {
          "$ref": "#/$defs/semanticRelation"
        },
        "state": {
          "$ref": "#/$defs/slug"
        },
        "verified_at": {
          "$ref": "#/$defs/date"
        }
      },
      "dependentRequired": {
        "state": [
          "verified_at"
        ]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9-]*$": true
      },
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "review-required",
            "accepted"
          ]
        },
        "reviewed_at": {
          "$ref": "#/$defs/date"
        },
        "reviewed_by": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reviewed_at"
            ]
          }
        }
      ]
    }
  }
}
